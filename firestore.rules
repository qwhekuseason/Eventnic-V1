rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function getRole() {
      // Return user role from users collection, or null
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return getRole() == 'ADMIN';
    }
    function isOrganizer() {
      return getRole() == 'ORGANIZER' || isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Events collection
    match /events/{eventId} {
      allow read: if true; // Anyone can read events
      allow create: if false; // Must be created via secure Backend API
      allow update: if (isAuthenticated() && isOrganizer() && resource.data.organizerEmail == request.auth.token.email)
                    || (isAuthenticated() && isAdmin());
      allow delete: if (isOrganizer() && resource.data.organizerEmail == request.auth.token.email) || isAdmin();
    }
    
    // Votes collection
    match /votes/{voteId} {
      allow read: if true; // Open to calculate results
      allow create: if false; // Must use Backend API
      allow update, delete: if false; // Votes are immutable
    }

    // Tickets collection
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
        || (isOrganizer() && get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.organizerEmail == request.auth.token.email)
      );
      allow create: if false; // Must use Backend API
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
        || (isOrganizer() && get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.organizerEmail == request.auth.token.email)
      );
      allow delete: if isAdmin();
    }

    // Nominations collection
    match /nominations/{nominationId} {
      allow read: if true;
      allow create: if true; // Anyone can nominate
      allow update, delete: if isOrganizer() || isAdmin();
    }

    // Marketplace collection
    match /marketplace/{listingId} {
      allow read: if true;
      allow create, update, delete: if isOrganizer() || isAdmin();
    }

    // Platform settings (finance, etc.)
    match /platformSettings/{docId} {
      allow read: if true; // Anyone can read platform settings (e.g. fee percentages)
      allow write: if isAuthenticated() && isAdmin();
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if true; // Created during checkout
      allow update, delete: if isAuthenticated() && isAdmin();
    }
    
    // Withdrawal Requests
    match /withdrawalRequests/{requestId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow read: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAuthenticated() && isAdmin();
    }
    
    // Default closed — any collection not explicitly listed above is blocked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
