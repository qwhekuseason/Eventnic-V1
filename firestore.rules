rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function getRole() {
      // Return user role from users collection, or null
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return getRole() == 'ADMIN';
    }
    function isOrganizer() {
      return getRole() == 'ORGANIZER' || isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Events collection
    match /events/{eventId} {
      allow read: if true; // Anyone can read events
      allow create: if isOrganizer();
      allow update: if (isOrganizer() && resource.data.organizerEmail == request.auth.token.email) || isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votingCategories', 'ticketTiers']));
      allow delete: if (isOrganizer() && resource.data.organizerEmail == request.auth.token.email) || isAdmin();
    }
    
    // Votes collection
    match /votes/{voteId} {
      allow read: if true; // Open to calculate results
      allow create: if true; // Anonymous voting allowed
      allow update, delete: if false; // Votes are immutable
    }

    // Tickets collection
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated(); // Organizers need to check them in, users might transfer
      allow delete: if isAdmin();
    }

    // Nominations collection
    match /nominations/{nominationId} {
      allow read: if true;
      allow create: if true; // Anyone can nominate
      allow update, delete: if isOrganizer() || isAdmin();
    }

    // Marketplace collection
    match /marketplace/{listingId} {
      allow read: if true;
      allow create, update, delete: if isOrganizer() || isAdmin();
    }
    
    // Default closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
